{
  "name": "@convex-chat/r2",
  "version": "0.1.0-alpha.0",
  "description": "Cloudflare R2 storage adapter for convex-chat attachments.",
  "keywords": [
    "chat",
    "cloudflare-r2",
    "convex",
    "storage",
    "typescript"
  ],
  "homepage": "https://github.com/dciccale/convex-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dciccale/convex-chat.git",
    "directory": "packages/r2"
  },
  "bugs": {
    "url": "https://github.com/dciccale/convex-chat/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc6 -p tsconfig.build.json",
    "dev": "tsc6 -p tsconfig.build.json --watch",
    "prepack": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc6 --noEmit"
  },
  "dependencies": {
    "@convex-dev/r2": "0.10.2"
  },
  "peerDependencies": {
    "convex": "^1.43.0",
    "convex-chat": "workspace:*"
  },
  "devDependencies": {
    "convex": "1.43.0",
    "convex-chat": "workspace:*",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "4.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
