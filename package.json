{
  "name": "convex-chat-workspace",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  },
  "scripts": {
    "build": "turbo build",
    "convex:dev": "pnpm --filter @convex-chat/example-backend convex:dev",
    "check:links": "node scripts/check-doc-links.mjs",
    "dev": "turbo dev",
    "dev:example": "pnpm --filter @convex-chat/example dev",
    "dev:example-native": "pnpm --filter @convex-chat/example-native start",
    "dev:web": "pnpm --filter @convex-chat/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "test:coverage": "pnpm --filter convex-chat test:coverage",
    "test:packed": "node scripts/test-packed-consumer.mjs",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
